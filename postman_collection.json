{
  "info": {
    "name": "Fuel Route Optimizer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Plan route + fuel stops (Chicago -> Denver)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/route/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "route", ""]
        }
      }
    },
    {
      "name": "Plan route + fuel stops (LA -> NYC, long haul, multiple stops)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Los Angeles, CA\",\n  \"finish\": \"New York, NY\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/route/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "route", ""]
        }
      }
    }
  ]
}
